# Copy to .env and adjust. No credentials are needed for any data source.

# Lets individual PyTorch ops that MPS does not support run on CPU instead of
# crashing. Future code should log when ops fall back: heavy fallback defeats
# the purpose of using the Apple GPU.
PYTORCH_ENABLE_MPS_FALLBACK=1

# Root data directory (raw/, processed/, graph/ live under it).
FLOODSHIELD_DATA_DIR=./data

# Where model checkpoints and outputs are written.
FLOODSHIELD_CHECKPOINT_DIR=./checkpoints
FLOODSHIELD_OUTPUT_DIR=./outputs
